# URL base delle API del backend (senza slash finale).
# Tutte le chiamate in src/api/*.js usano questo prefisso.
VITE_API_BASE_URL=https://api.tuodominio.it

# Se "true", l'app non chiama nessuna API reale: simula upload S3 e
# analisi con dati finti (vedi src/demo/mockData.js). Utile per lavorare
# sul frontend prima che il backend sia pronto, o per fare demo offline.
VITE_DEMO_MODE=true
